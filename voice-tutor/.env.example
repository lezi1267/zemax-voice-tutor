# 复制成 .env 再改。除 GLM_API_KEY 外都有默认值,不填也能跑。

# ── 脑:LLM(GLM_API_KEY 必填)────────────────────────
GLM_API_KEY=
GLM_MODEL=glm-4.5-air
# glm-4-flash 免费档知识浅;语音对话别用长思考模型(等不起)

# 看屏幕图用的视觉模型(同一个 key,都免费)。4.6v 更强但免费档常被挤爆,挤爆自动退到 4v
GLM_VISION_MODEL=glm-4.6v-flash,glm-4v-flash

# 1 = 屏幕截图直接进对话(她看像素,不是听视觉模型转述)。开了就得把 GLM_MODEL 换成带视觉的,
# 如 glm-4.6v-flash(免费)或 glm-4.6v(付费更强);glm-4.5-air 没有视觉,开了会被 API 拒收
MAIN_VISION=0

# 拖进来的资料用语义检索(智谱 embedding-2,便宜)。学一次存向量,提问只嵌一句话
GLM_EMBED_MODEL=embedding-2

# ── 念:TTS 引擎三选一 ────────────────────────────────
# piper   本地免费,中文只有两个女声。实测首音 0.47s —— 不是最快的,别以为本地就一定快
# edge    微软免费、播音级;这条服务实测 403 挂了(2026-10),别选
# minimax 云端付费,实测首音 0.33s(同句 3 次中位数,比 piper 快一半)且最好听 → 默认
TTS_ENGINE=minimax

# piper(本地,无需 key)
PIPER_VOICE=zh_CN-xiao_ya-medium
# 可选 zh_CN-huayan-medium(温柔女声);试听 voice-tutor\data\samples\

# piper / edge 共用语速,越大越慢
VOICE_SPEED=0.85

# TTS 文本聚合 —— 连贯 vs 反应快,二选一:
# sentence = 攒够一整句才开口,语调连贯(默认);代价是首音 2.89s
# token    = 边生成边合成,首音 1.36s 快一倍;但云端引擎(token 一次一请求)听起来一顿一顿
TTS_AGGREGATION=sentence

# edge(免费,无需 key)
EDGE_VOICE=zh-CN-XiaoyiNeural
# 可选 zh-CN-XiaoxiaoNeural 等;试听 data\samples\edge_*.wav

# minimax(需要 key)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1/t2a_v2
# 国内开放平台新式 key 也可能是 https://api.minimax.cn/v1/t2a_v2,看你在哪个站开的
MINIMAX_MODEL=speech-2.8-turbo
MINIMAX_VOICE=female-shaonv
MINIMAX_SPEED=1.0
MINIMAX_GROUP_ID=
# 新式 sk-api key 留空(自带分组,填错反而被拒);老 key 才需要填

# ── 出声设备 ─────────────────────────────────────────
# 输出设备名字片段(如 "Headphones"),多套蓝牙耳机来回切时锁死用;留空 = 系统默认
AUDIO_OUT_DEVICE=

# ── Zemax(选装)──────────────────────────────────────
# 默认 0 = 完全不碰 Zemax,纯语音聊天。要用读数/改镜头/指路,改成 1:
# 得你自己有合法授权,先开 OpticStudio 并点 编程 → 交互扩展
ZEMAX_ENABLED=0
